# Copy to .env and fill in. Never commit .env.

# --- Core ---------------------------------------------------------------
# "true" for local development only. With DEBUG off, the secrets below must
# not be the development placeholders or the server refuses to start.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL or MySQL in production, e.g. postgresql://cladasafari:secret@db:5432/cladasafari
# (cPanel/DirectAdmin MySQL: mysql://user:pass@localhost/dbname, plus `pip install mysqlclient`)
# Leave unset to use SQLite (db.sqlite3) for local development.
# DATABASE_URL=postgresql://cladasafari:cladasafari@127.0.0.1:5432/cladasafari

# --- Admin session ------------------------------------------------------
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_EXPIRES_DAYS=7
# Production only: the registrable parent domain shared by the web app and
# the API, e.g. .cladasafaribliss.com, so Next.js can read the cookie.
# COOKIE_DOMAIN=

# --- Web app integration ---------------------------------------------------
# The Next.js origin(s), comma separated. Used for CORS and the Origin check.
WEB_ORIGIN=http://localhost:3001
# This API's public base URL; baked into uploaded image URLs, so it must be
# the address a browser reaches this app on:
#   own host        PUBLIC_API_URL=https://api.cladasafaribliss.com      -> .../uploads/photo.jpg
#   under /api      PUBLIC_API_URL=https://cladasafaribliss.com/api      -> .../api/uploads/photo.jpg
PUBLIC_API_URL=http://localhost:8001
# Where saves are announced to the web app. Defaults to <WEB_ORIGIN>/api/revalidate.
# When this API is mounted at /api on the site's own domain that path reaches
# Django instead, so use the web app's second address for the same hook:
# REVALIDATE_URL=https://cladasafaribliss.com/hooks/revalidate
# Shared with the web app's REVALIDATE_SECRET so saves refresh public pages.
REVALIDATE_SECRET=change-me-too

# --- Seed ------------------------------------------------------------------
# `python manage.py seed` creates this administrator if it does not exist.
ADMIN_EMAIL=admin@cladasafaribliss.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Optional -----------------------------------------------------------------
# CACHE_URL=redis://127.0.0.1:6379/0   # share rate limits across workers
# SERVE_MEDIA=true                     # set false if a proxy serves /uploads/
# THROTTLE_ENQUIRIES=20/hour
