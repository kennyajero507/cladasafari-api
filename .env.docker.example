# Secrets for docker-compose.yml. Copy to .env.docker (kept apart from Django's own .env).
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
JWT_SECRET=
REVALIDATE_SECRET=
POSTGRES_PASSWORD=cladasafari
ADMIN_EMAIL=admin@cladasafaribliss.com
# At least 12 characters. Used once by `manage.py seed` to create the administrator.
ADMIN_PASSWORD=
# Local HTTP only: production cookies need HTTPS, so leave DJANGO_DEBUG=true
# when running the stack on localhost, and false behind HTTPS.
DJANGO_DEBUG=true
